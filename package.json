{
  "name": "symatic-temperature-rise-test",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Symatic Engineering Temperature Rise Test System",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --force",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:electron && tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "npm run build:electron && concurrently \"vite --force\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.symatic.temperaturerise",
    "productName": "Symatic Engineering - Temperature Rise Test System",
    "directories": {
      "output": "dist-exe"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.1.2",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wait-on": "^8.0.2"
  }
}
